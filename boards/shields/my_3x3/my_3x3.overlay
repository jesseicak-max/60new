/ {
	kscan0: kscan {
		compatible = "zmk,kscan-gpio-matrix";
		row-gpios = <&nice_nano 0 GPIO_ACTIVE_HIGH>,
					<&nice_nano 1 GPIO_ACTIVE_HIGH>,
					<&nice_nano 2 GPIO_ACTIVE_HIGH>;
		col-gpios = <&nice_nano 3 GPIO_ACTIVE_HIGH>,
					<&nice_nano 4 GPIO_ACTIVE_HIGH>,
					<&nice_nano 5 GPIO_ACTIVE_HIGH>;
		status = "okay";
	};

	chosen {
		zmk,kscan = &kscan0;
	};
};
 
